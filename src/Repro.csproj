<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repro for godotengine/godot#123707 (Disposable not registered -> SIGABRT from the finalizer thread).
       The reporter ran .NET 9; this machine has .NET 10. Finalizer semantics are the same. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>repro</AssemblyName>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

</Project>
